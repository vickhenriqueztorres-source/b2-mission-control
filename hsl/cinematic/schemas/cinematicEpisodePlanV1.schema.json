{
  "$id": "hsl.cinematic.episode.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "ruleset", "episode_id", "source",
    "cinematic_plan_revision", "scene_plans", "status", "generated_at"
  ],
  "properties": {
    "schema": {"const": "hsl.cinematic.episode.v1"},
    "schema_version": {"const": "1.1.0"},
    "ruleset": {"const": "HSL_CINEMATIC_V1"},
    "episode_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_available", "visual_plan_available", "claim_registry_available", "source_revision"],
      "properties": {
        "script_available": {"type": "boolean"},
        "visual_plan_available": {"type": "boolean"},
        "claim_registry_available": {"type": "boolean"},
        "source_revision": {"type": "string", "pattern": "^sha256_[a-f0-9]{64}$"}
      }
    },
    "cinematic_plan_revision": {"type": "string", "pattern": "^sha256_[a-f0-9]{64}$"},
    "scene_plans": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^cinematic/[A-Za-z0-9][A-Za-z0-9._-]*\\.cinematic\\.json$"}
    },
    "status": {"const": "shadow_generated"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
